rules_version = '2';

// Daybook sync: each signed-in person can only read and write their own encrypted snapshot.
// Everything stored is ciphertext made on their device; nothing else in the database is reachable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /sync/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /parts/{part} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
